# Project-specific ignores

# Raw data directory — contains multi-gigabyte .mat files, never tracked
data/
# ...but preserve the directory structure with .gitkeep placeholders
!data/**/.gitkeep

# Regeneratable classification result plots (CSVs are tracked, PNGs are not)
bip/classification_artifacts/*.png

# Master dataset CSV — large generated file, reproducible by running build_master_dataset.py
bip/classification_artifacts/master_chemistry_dataset.csv

# Dataset store caches / local databases
bip_data_store/

# Redundant legacy STM32 generic model (replaced by per-chemistry models)
stm32_export/soh_model/

# Node.js dependencies
node_modules/
